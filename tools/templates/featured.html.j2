{% if x.kind == 'series' %}
<section class="blk feat series" data-feat="{{ x.feat_index }}" data-dates='{{ x.dates_json }}' style="order:{{ 10 + x.feat_index }}">
  <div class="kicker">Featured</div>
  <h3 class="title-blue">{{ x.title }}</h3>
  <div class="with">{{ x.cadence }} · <span class="s-time">{{ x.time }}</span></div>
  <div class="meta">{{ x.format }}{% if x.place %} · {{ x.place }}{% endif %}{% if x.host %} · hosted by {{ x.host }}{% endif %}</div>
  <div class="meta">Next: <span class="s-next">{{ x.next }}</span></div>
  {% if x.requires %}<div class="requires">{{ x.requires }}</div>{% endif %}
  {% if x.description %}<p class="summary">{{ x.description }}</p>{% endif %}
  {% if x.notes %}<p class="summary">{{ x.notes }}</p>{% endif %}
  {% for l in x.links %}<div><a href="{{ l.url }}">{{ l.title }}</a></div>{% endfor %}
  {% if x.zoom_url %}<div><a class="cta" href="{{ x.zoom_url }}">{{ x.zoom_text }}</a></div>
  {% elif x.zoom_text %}<div class="meta">{{ x.zoom_text }}</div>{% endif %}
</section>
{% else %}
<section class="blk feat" data-feat="{{ x.feat_index }}" data-last="{{ x.last.isoformat() if x.last else '' }}" style="order:{{ 10 + x.feat_index }}">
  <div class="kicker">Featured event</div>
  <h3 class="title-blue">{{ x.title }}</h3>
  {% if x.teachers %}<div class="with">with {{ x.teachers }}</div>{% endif %}
  <div class="meta"><strong>{{ x.date_text }}</strong>{% if x.time %} · {{ x.time }}{% endif %}</div>
  <div class="meta">{% if x.format %}{{ x.format }}{% endif %}{% if x.place and x.place != x.format %} · {{ x.place }}{% endif %}</div>
  {% if x.languages %}<div class="meta">Language: {{ x.languages }}</div>{% endif %}
  {% if x.access_kind == 'requires' %}<div class="requires">{{ x.access }}</div>
  {% elif x.access_kind == 'unknown' %}<div class="requires unknown">{{ x.access }}</div>
  {% elif x.access_kind == 'open' %}<div class="meta">{{ x.access }}</div>{% endif %}
  {% if x.summary %}<p class="summary">{{ x.summary }}</p>{% if x.summary_draft %}<div class="badge warn">Draft summary: not yet reviewed (hidden in the publish build)</div>{% endif %}{% endif %}
  {% if x.note %}<div class="localnote"><strong>Local note:</strong> {{ x.note }}</div>{% endif %}
  {% if x.registration_url %}<div><a class="cta" href="{{ x.registration_url }}">More information and registration</a></div>{% endif %}
  {% if x.source_url %}<div class="attrib">{{ x.attribution }}: <a href="{{ x.source_url }}">source page</a></div>{% endif %}
  {% for b in x.badges %}<div class="badge warn">{{ b }}</div>{% endfor %}
</section>
{% endif %}
